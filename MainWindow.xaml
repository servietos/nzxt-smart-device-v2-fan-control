<Window x:Class="NzxtFan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lüftersteuerung" Width="1120" Height="920" MinWidth="860" MinHeight="740"
        Icon="app.ico" Background="{DynamicResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid Margin="28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopfzeile -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="CpuCard" Background="{DynamicResource CardGradient}" CornerRadius="14" Padding="22,10" Margin="0,0,12,0" MinWidth="150">
                        <StackPanel>
                            <TextBlock Text="CPU" Foreground="{DynamicResource Muted}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CpuTemp" Text="–" FontSize="40" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="GpuCard" Background="{DynamicResource CardGradient}" CornerRadius="14" Padding="22,10" Margin="0,0,12,0" MinWidth="150">
                        <StackPanel>
                            <TextBlock Text="GPU" Foreground="{DynamicResource Muted}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GpuTemp" Text="–" FontSize="40" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="UndoBtn" Style="{StaticResource Btn}" FontSize="18" Width="44" Height="44" Padding="0" Margin="0" Content="↶" Click="Undo_Click"/>
                        <Button x:Name="SettingsBtn" Style="{StaticResource Btn}" FontSize="18" Width="44" Height="44" Padding="0" Content="⚙" Click="Settings_Click"/>
                        <Button x:Name="HelpBtn" Style="{StaticResource Btn}" FontSize="16" FontWeight="Bold" Width="44" Height="44" Padding="0" Content="?" Click="Help_Click"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Warnungen -->
            <StackPanel Grid.Row="1">
                <Border x:Name="CamBanner" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource Warn}" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="CamText" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" FontSize="13"/>
                </Border>
                <Border x:Name="PawnBanner" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource Warn}" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="PawnText" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" FontSize="13"/>
                </Border>
            </StackPanel>

            <!-- Profil = gesamte Abstimmung -->
            <WrapPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock x:Name="ProfileLbl" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="ProfileBox" Width="230" VerticalAlignment="Center" SelectionChanged="ProfileBox_SelectionChanged"/>
                <Button x:Name="ProfileMoreBtn" Style="{StaticResource Btn}" Content="⋯" FontSize="16" Width="40" Height="36" Padding="0" Click="MoreBtn_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="MenuDuplicate" Click="Duplicate_Click"/>
                            <MenuItem x:Name="MenuRenameProfile" Click="RenameProfile_Click"/>
                            <MenuItem x:Name="MenuDeleteProfile" Click="DeleteProfile_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>

            <!-- Umschalter Lüfter / Beleuchtung -->
            <Border Grid.Row="3" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10"
                    Padding="3" Margin="0,18,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabFans" Style="{StaticResource Seg}" GroupName="tab" FontSize="14" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabLight" Style="{StaticResource Seg}" GroupName="tab" FontSize="14" Checked="Tab_Checked"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4">
                <Grid x:Name="FansPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                <!-- Lüfterkacheln -->
                <UniformGrid x:Name="Tiles" Grid.Row="0" Rows="1" Columns="3" Margin="-8,18,-8,0"/>

                <!-- Kurven-Editor -->
                <Border x:Name="CurveCard" Grid.Row="1" Background="{DynamicResource CardGradient}" CornerRadius="16" Padding="20,16" Margin="0,22,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Zuordnung des Lüfters (gehört zum Profil) -->
                        <WrapPanel>
                            <TextBlock x:Name="EditorTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <TextBlock x:Name="CurveLbl" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CurveBox" Width="240" VerticalAlignment="Center" SelectionChanged="CurveBox_SelectionChanged"/>
                            <Button x:Name="CurveMoreBtn" Style="{StaticResource Btn}" Content="⋯" FontSize="16" Width="40" Height="36" Padding="0" Click="MoreBtn_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="MenuCurveSaveAs" Click="CurveSaveAs_Click"/>
                                        <MenuItem x:Name="MenuCurveRename" Click="CurveRename_Click"/>
                                        <MenuItem x:Name="MenuCurveDelete" Click="CurveDelete_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock x:Name="TempFromLbl" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="18,0,10,0"/>
                            <Border Background="{DynamicResource Bg}" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SrcCpu" Content="CPU" Style="{StaticResource Seg}" GroupName="src" Checked="Source_Checked"/>
                                    <RadioButton x:Name="SrcGpu" Content="GPU" Style="{StaticResource Seg}" GroupName="src" Checked="Source_Checked"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="ApplyAllBtn" Style="{StaticResource Btn}" Margin="12,0,0,0" Click="ApplyAll_Click"/>
                            <!-- Info-Symbol: zeigt, wo die Kurve verwendet wird, und den Bedienhinweis. Als Text unter der Kurve ragte beides bei kleinem Fenster in die Kurve -->
                            <TextBlock x:Name="HintText" Text="ⓘ" FontSize="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" Cursor="Help"
                                       ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000"/>
                        </WrapPanel>

                        <Canvas x:Name="Chart" Grid.Row="2" Margin="0,14,0,0" ClipToBounds="False" Background="Transparent" MinHeight="200"
                                SizeChanged="Chart_SizeChanged" MouseMove="Chart_MouseMove" MouseLeftButtonUp="Chart_MouseUp"/>
                    </Grid>
                </Border>
                </Grid>

                <!-- Beleuchtung (Inhalt wird im Code aufgebaut) -->
                <ScrollViewer x:Name="LightPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel x:Name="LightContent"/>
                </ScrollViewer>
            </Grid>

            <!-- Eine Speicherleiste für alles, nur sichtbar bei ungespeicherten Änderungen -->
            <Border x:Name="SaveBar" Grid.Row="5" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource Warn}" BorderThickness="1"
                    CornerRadius="12" Padding="16,10" Margin="0,16,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="SaveBarSave" DockPanel.Dock="Right" Style="{StaticResource Btn}" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}"
                            Foreground="White" FontWeight="SemiBold" Padding="20,8" Click="SaveAll_Click"/>
                    <Button x:Name="SaveBarDiscard" DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="16,8" Click="DiscardAll_Click"/>
                    <TextBlock x:Name="SaveBarText" Foreground="{DynamicResource Warn}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Overlay: Namenseingabe, Einstellungen, Hilfe -->
        <Grid x:Name="Overlay" Visibility="Collapsed">
            <Border Background="#99000000" MouseLeftButtonDown="Overlay_BackdropClick"/>
            <Border x:Name="OverlayCard" Background="{DynamicResource Card}" CornerRadius="16" Padding="26,22" MaxWidth="720" MaxHeight="760"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button x:Name="OverlayCloseBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="OverlayClose_Click"/>
                        <TextBlock x:Name="OverlayTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Namenseingabe -->
                    <StackPanel x:Name="NamePanel" DockPanel.Dock="Top" Visibility="Collapsed">
                        <TextBox x:Name="NameBox" Width="420" HorizontalAlignment="Left" KeyDown="NameBox_KeyDown"/>
                        <TextBlock x:Name="NameHintText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Lüfter bearbeiten (im Code aufgebaut) -->
                    <StackPanel x:Name="FanEditPanel" DockPanel.Dock="Top" Visibility="Collapsed"/>

                    <!-- Farbwähler -->
                    <StackPanel x:Name="ColorPanel" DockPanel.Dock="Top" Visibility="Collapsed">
                        <WrapPanel x:Name="Swatches" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ColorPreview" Width="96" Height="96" CornerRadius="14" Margin="0,0,18,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="HueLbl" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                <Slider x:Name="HueSlider" Minimum="0" Maximum="360" ValueChanged="Hsv_Changed" Margin="0,2,0,8"/>
                                <TextBlock x:Name="SatLbl" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                <Slider x:Name="SatSlider" Minimum="0" Maximum="100" ValueChanged="Hsv_Changed" Margin="0,2,0,8"/>
                                <TextBlock x:Name="ValLbl" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                <Slider x:Name="ValSlider" Minimum="0" Maximum="100" ValueChanged="Hsv_Changed" Margin="0,2,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="HexBox" Width="120" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus"/>
                                    <Button x:Name="ColorOkBtn" Style="{StaticResource Btn}" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}"
                                            Foreground="White" FontWeight="SemiBold" Margin="12,0,0,0" Click="ColorOk_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Einstellungen -->
                    <ScrollViewer x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="SetAppearanceLbl" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Border Background="{DynamicResource Bg}" CornerRadius="8" Padding="3" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeDark" Style="{StaticResource Seg}" GroupName="theme" Checked="Theme_Checked"/>
                                        <RadioButton x:Name="ThemeLight" Style="{StaticResource Seg}" GroupName="theme" Checked="Theme_Checked"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="SetLanguageLbl" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Background="{DynamicResource Bg}" CornerRadius="8" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LangDe" Content="Deutsch" Style="{StaticResource Seg}" GroupName="lang" Checked="Lang_Checked"/>
                                        <RadioButton x:Name="LangEn" Content="English" Style="{StaticResource Seg}" GroupName="lang" Checked="Lang_Checked"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <TextBlock x:Name="SetWindowLbl" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,8"/>
                            <Border Background="{DynamicResource Bg}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="MinTray" Style="{StaticResource Seg}" GroupName="min" Checked="Min_Checked"/>
                                    <RadioButton x:Name="MinBoth" Style="{StaticResource Seg}" GroupName="min" Checked="Min_Checked"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="SetCloseNote" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <TextBlock x:Name="SetStartLbl" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,8"/>
                            <CheckBox x:Name="AutostartBox" Foreground="{DynamicResource Text}" FontSize="14" Click="Autostart_Click"/>

                            <TextBlock x:Name="SetDevicesLbl" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,8"/>
                            <CheckBox x:Name="FansEnabledBox" FontSize="14" Click="FansEnabled_Click"/>
                            <CheckBox x:Name="LightingEnabledBox" FontSize="14" Margin="0,10,0,0" Click="LightingEnabled_Click"/>
                            <StackPanel x:Name="LightDeviceList" Margin="30,8,0,0"/>
                            <TextBlock x:Name="OpenRgbPathText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="30,6,0,0"/>
                            <Button x:Name="OpenRgbPathBtn" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="30,8,0,0" Click="OpenRgbPath_Click"/>

                            <TextBlock x:Name="SetAccentLbl" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,8"/>
                            <WrapPanel>
                                <Border Background="{DynamicResource Bg}" CornerRadius="8" Padding="3" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="AccentFixed" Style="{StaticResource Seg}" GroupName="accent" Checked="Accent_Checked"/>
                                        <RadioButton x:Name="AccentLight" Style="{StaticResource Seg}" GroupName="accent" Checked="Accent_Checked"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="AccentColorBtn" Style="{StaticResource Btn}" Width="44" Height="34" Padding="0" Click="AccentColor_Click"/>
                                <ComboBox x:Name="AccentZoneBox" Width="280" Margin="12,0,0,0" SelectionChanged="AccentZone_Changed"/>
                            </WrapPanel>
                            <!-- Farben von Lüfterrädern und Kurve (im Code aufgebaut) -->
                            <StackPanel x:Name="UiColorPanel" Margin="0,6,0,0"/>

                            <TextBlock x:Name="SetSystemLbl" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,8"/>
                            <TextBlock x:Name="PawnStatus" FontSize="13"/>
                            <TextBlock x:Name="AppVersionText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                            <Button x:Name="OpenFolderBtn" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenFolder_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Hilfe -->
                    <ScrollViewer x:Name="HelpPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel x:Name="HelpContent"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
